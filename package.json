{
  "name": "universalvideomaximizer",
  "version": "3.1.210",
  "license": "MIT",
  "bugs": "https://github.com/trophygeek/universalvideomaximizer/issues",
  "npmClient": "pnpm",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/chrome": "^0.1.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.2",
    "cross-env": "^10.1.0",
    "glob": "^13.0.0",
    "jest": "^30.2.0",
    "magic-string": "^0.30.21",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-zip": "^1.0.3",
    "ts-jest": "^29.4.6",
    "ts-jest-mock-import-meta": "^1.3.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "browserslist": {
    "production": [
      ">0.2%"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "scripts": {
    "start": "NODE_ENV=development rollup --watch --watch.skipWrite=false --externalImportAssertions -c rollup.config.mjs --environment BUILD:development",
    "build": "NODE_ENV=production rollup -c rollup.config.mjs --environment BUILD:production",
    "build:dev": "NODE_ENV=development rollup -c rollup.config.mjs --environment BUILD:development",
    "clean": "rimraf dist/videomaximizer",
    "test": "NODE_ENV=test jest --force-exit",
    "lint:fix": "prettier --bracket-same-line  --print-width 100 --write \"src/**/*.{ts,tsx}\"",
    "update": "npm install && npm update",
    "buildpackage": "pnpm build && node ./scripts/bundlepackage.js"
  },
  "sideEffects": false
}
