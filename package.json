{
  "name": "universalvideomaximizer",
  "version": "3.1.204",
  "license": "MIT",
  "bugs": "https://github.com/trophygeek/universalvideomaximizer/issues",
  "npmClient": "yarn",
  "dependencies": {},
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/chrome": "^0.0.293",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "magic-string": "^0.30.11",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.30.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-zip": "^1.0.3",
    "ts-jest": "^29.2.5",
    "ts-jest-mock-import-meta": "^1.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "browserslist": {
    "production": [
      ">0.2%"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "scripts": {
    "start": "NODE_ENV=development rollup --watch --watch.skipWrite=false --externalImportAssertions -c rollup.config.mjs --environment BUILD:development",
    "build": "NODE_ENV=production rollup -c rollup.config.mjs --environment BUILD:production",
    "build:dev": "NODE_ENV=development rollup -c rollup.config.mjs --environment BUILD:development",
    "clean": "rimraf dist/videomaximizer",
    "test": "NODE_ENV=test jest --force-exit",
    "lint:fix": "prettier --bracket-same-line  --print-width 100 --write \"src/**/*.{ts,tsx}\"",
    "update": "git checkout -- yarn.lock && yarn install && yarn upgrade-interactive --latest",
    "buildpackage": "yarn build && node ./scripts/bundlepackage.js"
  },
  "sideEffects": false
}
