{
  "name": "universalvideomaximizer",
  "version": "3.1.204",
  "license": "MIT",
  "bugs": "https://github.com/trophygeek/universalvideomaximizer/issues",
  "npmClient": "yarn",
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/chrome": "^0.0.269",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "cross-env": "^7.0.3",
    "glob": "^11.0.0",
    "jest": "^29.7.0",
    "magic-string": "^0.30.11",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.20.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-empty-dir": "^1.0.5",
    "rollup-plugin-inline-js": "^0.5.0",
    "rollup-plugin-zip": "^1.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.5.2",
    "vite": "^5.3.2"
  },
  "browserslist": {
    "production": [
      ">0.2%"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "scripts": {
    "start": "NODE_ENV=development rollup --watch --watch.skipWrite=false --externalImportAssertions -c rollup.config.mjs --environment BUILD:development",
    "build": "NODE_ENV=production rollup -c rollup.config.mjs --environment BUILD:production",
    "build:dev": "NODE_ENV=development rollup -c rollup.config.mjs --environment BUILD:development",
    "clean": "rimraf dist/videomaximizer",
    "test": "jest --force-exit",
    "lint:fix": "prettier --bracket-same-line  --print-width 100 --write \"src/**/*.{ts,tsx}\"",
    "update": "git checkout -- yarn.lock && yarn install && yarn upgrade --lastest",
    "buildpackage": "yarn build && node ./scripts/bundlepackage.js"
  },
  "sideEffects": false
}
