{
  "name": "universalvideomaximizer",
  "version": "3.1.125",
  "license": "MIT",
  "bugs": "https://github.com/trophygeek/universalvideomaximizer/issues",
  "npmClient": "yarn",
  "dependencies": {
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/chrome": "^0.0.240",
    "@types/jest": "^29.5.7",
    "@types/node": "^20.9.3",
    "cross-env": "^7.0.3",
    "glob": "^7.2.3",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "rimraf": "^3.0.2",
    "rollup": "^4.6.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-empty-dir": "^1.0.5",
    "rollup-plugin-zip": "^1.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.11"
  },
  "browserslist": {
    "production": [
      ">0.2%"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "scripts": {
    "style": "prettier --write \"src/**/*.{ts,tsx}\"",
    "start": "yarn build:dev",
    "tsc": "tsc",
    "build": "rollup -c rollup.config.mjs --environment BUILD:production",
    "build:dev": "NODE_ENV=development rollup -w -c rollup.config.mjs --no-treeshake --environment BUILD:development",
    "clean": "rimraf dist",
    "test": "npx jest",
    "update": "git checkout -- yarn.lock && yarn install && yarn upgrade-interactive --lastest",
    "buildpackage": "yarn build:prod && node ./scripts/bundlepackage.js"
  },
  "sideEffects": false
}
