{
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": false,
    "rootDir": "./src",
    "outDir": "dist/videomaximizer",
    "noEmitOnError": false,

    "target": "ESNext",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "isolatedModules": false,
    "resolveJsonModule": true,
    "sourceMap": false,

    "lib": [
      "ES2023",
      "dom",
      "dom.iterable"],
    "typeRoots": [
      "node_modules/@types",
      "@types",
      "@types/videomax",
      "src"],
    "types": [
      "videomax",
      "chrome",
      "jest"
    ]
  }
}
