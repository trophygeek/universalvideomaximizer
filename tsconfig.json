{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": false,
    "rootDir": "./src",
    "outDir": "dist/videomaximizer",
    "noEmitOnError": false,
    "lib": ["dom", "dom.iterable","ES2022"],
    "typeRoots": [
      "./node_modules/@types",
      "./@types"
    ],
    "types": [
      "videomax",
      "chrome",
      "jest"
    ]
  }
}
